<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-иконка (Android 8.0+). Без этого файла лаунчер берёт легаси-PNG и
  не применяет к нему маску: на телефонах, где все иконки круглые/сквокл,
  приложение выглядит квадратным чужеродным пятном.

  Исходный логотип сохранён как есть; слои собирает tool/make_icons.ps1 из
  mipmap-xxxhdpi/ic_launcher.png. Логотип вписан в 63% ширины канвы, потому
  что лаунчер вырезает из 108dp только маску ~72dp и концы надписи иначе
  отрезались бы.

  Монохромный слой — для «тематических значков» Android 13+, где система
  перекрашивает иконку в цвет темы.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
